# DEPLOYMENT PRIVATE KEY
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# SHARED SETTINGS FOR .env
LOCALHOST_RPC_URL=http://127.0.0.1:8545
DEPLOY_CHAINS=base,sepolia,arb-sepolia,celo,arbitrum
ETHERSCAN_API_KEY=your_explorer_key
# Verification mode for deploy_all.sh: auto | true | false
# auto disables verification on local chain IDs (31337/1337), enables elsewhere.
VERIFY_MODE=auto

# Per-chain template for .env.<chain>
CHAIN_ID=31337
RPC_URL=http://127.0.0.1:8545

# Optional explorer override for chains that need a custom verifier endpoint.
ETHERSCAN_API_URL=

# davinci-zkvm program keys pinned by ProcessRegistry (bytes32 hex)
BATCH_PROGRAM_VK=0x
RESULTS_PROGRAM_VK=0x
ROOT_C_VADCOP_FINAL=0x
BALLOT_VK_HASH=0x

# A deployed ZiskVerifier to reuse (unset deploys a new one); it must report ROOT_C_VADCOP_FINAL.
ZISK_VERIFIER=

# A live ProcessRegistry on this chain to inherit from: its ZiskVerifier is reused and its pins
# and grace settings copied, replacing the four pins above (any of them, ZISK_VERIFIER or the
# grace variables also set must agree with it).
PINS_FROM_REGISTRY=

# davinci-dkg DKGManager for the DKG key modes (unset or zero disables them).
DKG_MANAGER=
# Council manager for the COUNCIL key mode (unset or zero disables it).
COUNCIL_MANAGER=

# ProcessRegistry grace window and shorten notice, in seconds (unset keeps these defaults).
# GRACE_DEFAULT=180
# GRACE_FLOOR=150
# GRACE_CEIL=600
# GRACE_MAX_TOTAL=1800
# NOTICE_MIN=60
# The values deploy_all.sh must read back (DEFAULT,FLOOR,CEIL,MAX_TOTAL,NOTICE): a misspelled
# variable above silently keeps its default.
# EXPECT_GRACE=180,150,600,1800,60

# L1-blob mode (OP Stack chains): a deployed L1BlobVerifier to use, or the chain's L1Block to
# deploy one on (the OP predeploy is 0x4200000000000000000000000000000000000015). Both unset
# deploys a blob-mode registry.
L1_BLOB_VERIFIER=
L1_BLOCK=
# The mode this deployment must have (l1|blob), checked before anything is sent: a misspelled
# variable above silently gives a blob-mode registry. Required on every chain except 31337 and 1337.
# EXPECT_DA_MODE=l1
